# Local SQLite database for lead capturee
DATABASE_URL="file:./prisma/dev.db"

# --- Email notifications (Resend) ---------------------------------------
# When a teardown is submitted, a notification email is sent via Resend.
# Get a key at https://resend.com (sign up with the inbox below so you can
# use the built-in onboarding@resend.dev sender with no domain verification).
# If RESEND_API_KEY is unset, email is skipped and the form still works.
RESEND_API_KEY=""

# Where new-lead notifications are sent.
NOTIFY_EMAIL="touchtabletapps@gmail.com"

# Sender shown on the notification and on the agent-demo result email. The
# default works with any Resend account; use a verified-domain address once you
# have one. The demo result email lands in a stranger's inbox, so it should be
# sent from the verified maubourg.studio domain, not onboarding@resend.dev.
NOTIFY_FROM="Maubourg Studio <hello@maubourg.studio>"

# --- Live agent demo (/en/try-an-agent, /fr/essayer-un-agent) ------------
# Server-side only, never exposed to the browser. If this is unset the demo
# returns MODEL_ERROR and the rest of the site is unaffected.
ANTHROPIC_API_KEY=""

# Optional: pin a dated model snapshot instead of the default alias.
# ANTHROPIC_MODEL="claude-sonnet-5"

# Runs allowed across all visitors per day. The model call happens before the
# email gate, so this is the budget ceiling. Default 15 (about 450 a month).
AGENT_DEMO_DAILY_CAP="15"

# Salt for hashing visitor IPs in the rate limiter. Raw IPs are never stored;
# without a salt the hash of an IPv4 address is trivial to reverse. Any long
# random string. Changing it resets the per-visitor limits.
AGENT_DEMO_IP_SALT=""

# Bearer token for GET /api/agent-demo/metrics (runs, reveals, errors by code).
# Leave it unset and the endpoint 404s, which is the safe default.
AGENT_DEMO_METRICS_TOKEN=""
